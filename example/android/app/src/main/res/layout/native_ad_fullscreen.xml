<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="false"
    android:focusable="false">

    <com.google.android.gms.ads.nativead.MediaView
        android:id="@+id/ad_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ad_full_click_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:id="@+id/ad_bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/native_ad_fullscreen_scrim"
        android:clickable="false"
        android:focusable="false" />

    <com.google.android.gms.ads.nativead.AdChoicesView
        android:id="@+id/ad_choices_view"
        android:layout_width="48dp"
        android:layout_height="28dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:background="#E6FFFFFF"
        android:clickable="false"
        android:focusable="false"
        android:padding="2dp" />

    <LinearLayout
        android:id="@+id/ad_headline_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="178dp"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_icon_container"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="102dp"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ad_body_container"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="96dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="102dp"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#D8D8D8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#A9A9A9"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ad_cta_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="34dp"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/native_ad_fullscreen_cta_bg"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
